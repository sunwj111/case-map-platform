  "rules": [
    {"id": "CMP-R001", "name": "置信度分层挂载", "description": "置信度>=80自动挂载；60-79人工抽检；<60人工确认。", "node": "用例地图生成与挂载", "testType": "规则校验"},
    {"id": "CMP-R002", "name": "评审池准入", "description": "缺口用例与低置信度用例不得直接进入正式全集，必须进入评审池。", "node": "人工评审校准", "testType": "规则校验"},
    {"id": "CMP-R003", "name": "测试依据必绑", "description": "每条正式用例至少绑定一种测试依据（状态/字段/规则/场景/接口）。", "node": "用例资产入库与复用", "testType": "规则校验"},
    {"id": "CMP-R004", "name": "核心回归优选", "description": "优先纳入P0/P1、高风险节点、状态流转、规则校验、数据一致性、历史缺陷相关用例。", "node": "核心回归集管理", "testType": "规则校验"},
    {"id": "CMP-R005", "name": "生效版本唯一", "description": "同一caseId同时仅允许一个ACTIVE生效版本。", "node": "用例版本管理", "testType": "规则校验"},
    {"id": "CMP-R006", "name": "生命周期发布约束", "description": "仅CONFIRMED可发布；仅PUBLISHED可作为正式回归基线引用。", "node": "用例生命周期管理", "testType": "状态流转"},
    {"id": "CMP-R007", "name": "追溯深度上限", "description": "多层级追溯depth默认2，最大不超过配置上限（建议5），超限拦截。", "node": "多层级关联追溯", "testType": "边界值"},
    {"id": "CMP-R008", "name": "停用场景挂载限制", "description": "场景停用后不可新建挂载，历史挂载只读可查。", "node": "场景管理", "testType": "规则校验"},
    {"id": "CMP-R009", "name": "链路变更重算", "description": "上下游链路变更后需触发关联用例重算或标记stale。", "node": "多维检索与图谱查询", "testType": "数据一致性"},
    {"id": "CMP-R010", "name": "入库追溯字段必填", "description": "入库必填knowledgeSourceVersion与originalCaseId。", "node": "用例资产入库与复用", "testType": "规则校验"},
    {"id": "CMP-R011", "name": "导入缺字段降置信度", "description": "Excel缺字段可容忍，但需降低置信度并提示风险。", "node": "历史用例导入", "testType": "异常流"},
    {"id": "CMP-R012", "name": "AI结果人工把关", "description": "AI生成用例必须标记sourceType=AI_GAP并经人工评审。", "node": "缺口用例池管理", "testType": "规则校验"},
    {"id": "CMP-R013", "name": "多维组合查询", "description": "至少支持关键词、场景、应用、接口、上下游链路组合过滤。", "node": "多维检索与图谱查询", "testType": "主流程"},
    {"id": "CMP-R014", "name": "四层层级主视图", "description": "主视图按领域→流程节点→测试依据→用例资产展示，禁止仅平铺列表。", "node": "用例层级查看", "testType": "展示校验"},
    {"id": "CMP-R015", "name": "一期边界约束", "description": "一期不改造质保平台、不强依赖实时接口、不建设复杂多级审批。", "node": "价值应用赋能", "testType": "规则校验"},
    {"id": "CMP-R016", "name": "追溯环路处理", "description": "上下游存在环路时需去重截断并提示，避免无限展开。", "node": "多层级关联追溯", "testType": "异常流"},
    {"id": "CMP-R017", "name": "版本回滚一致性", "description": "回滚后原ACTIVE归档，目标版本变为ACTIVE，关联回归集引用同步更新。", "node": "用例版本管理", "testType": "数据一致性"},
    {"id": "CMP-R018", "name": "废弃用例回归引用拦截", "description": "已废弃用例不可被新回归包直接引用为正式基线。", "node": "核心回归集管理", "testType": "异常流"}
  ],
