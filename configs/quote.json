  "rules": [
    {"id": "R001", "name": "固定价物品总价", "description": "totalPriceRule=FIXED_PRICE 时总价=单价。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R002", "name": "数量价物品总价", "description": "totalPriceRule=QUANTITY_PRICE 时总价=round(unitPrice*amount,2)。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R003", "name": "租赁物品总价", "description": "租赁物品总价=round(amount*unitPrice*rentalCycle,2)。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R004", "name": "去利润总价", "description": "noProfitPrice=round(totalPrice/(1+profitRate),2)。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R005", "name": "分组汇总", "description": "按 itemGroup 汇总硬装/软装基础和增项金额。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R006", "name": "场景价格来源映射", "description": "SFBJ/LFBJ/JZBJ/PZYJ→MLJ；轻托管/选配等→XSJJS。", "node": "报价场景识别与价格来源", "testType": "规则校验"},
    {"id": "R007", "name": "自动审核判定", "description": "产品版本、改价标签、复审、驳回记录、抽审比例共同决定是否自动通过。", "node": "造价提交与审核", "testType": "规则校验"},
    {"id": "R008", "name": "基础参数校验", "description": "功能区间、单价、数量、operateType 不能为空或非法。", "node": "参数解析与输入精度", "testType": "规则校验"},
    {"id": "R009", "name": "定制二级分类校验", "description": "定制设计 ADD/UPDATE 物品的二级展示分类必须有值。", "node": "参数解析与输入精度", "testType": "规则校验"},
    {"id": "R010", "name": "配件参数校验", "description": "配件标签物品必须有关联父 SKU 和比例。", "node": "物料处理与自动带出", "testType": "规则校验"},
    {"id": "R011", "name": "uniqueCode 去重", "description": "同一条物品信息不可重复添加。", "node": "物料处理与自动带出", "testType": "规则校验"},
    {"id": "R012", "name": "配件比例校验", "description": "配件数量=round(比例*主物品数量,2)。", "node": "物料处理与自动带出", "testType": "规则校验"},
    {"id": "R013", "name": "UPDATE 数量为0", "description": "UPDATE 且 amount=0 时逻辑删除并置 CANCEL。", "node": "造价提交与审核", "testType": "状态流转"},
    {"id": "R014", "name": "通用数值四舍五入与找平", "description": "每步计算四舍五入到2位，支持 maxPriceLeveling 金额找平。", "node": "金额计算与汇总", "testType": "边界值"},
    {"id": "R015", "name": "标准出房价双源回退", "description": "先查 k2，无值再调定价系统 computeStandardPrice，回写 standardRentalPrice。", "node": "报价场景识别与价格来源", "testType": "规则校验"},
    {"id": "R016", "name": "造价单可编辑状态", "description": "仅 INIT(0) 或 REJECT(30) 可编辑。", "node": "造价提交与审核", "testType": "状态流转"},
    {"id": "R017", "name": "审核通过失效时间", "description": "标准场景 invalidTime=now+15天；长租场景 now+30天。", "node": "生命周期与外部联动", "testType": "规则校验"},
    {"id": "R018", "name": "签约合同阻止失效", "description": "合同签约后 prohibitExpireType=HAS_HIRE_CONTRACT，阻止时效失效。", "node": "生命周期与外部联动", "testType": "规则校验"},
    {"id": "R019", "name": "长租库存预占判定", "description": "judgeNeedLockStockAndExpire 为真时审核通过触发预占；心舍市场化或非新建可不占库存。", "node": "生命周期与外部联动", "testType": "规则校验"},
    {"id": "R020", "name": "申诉 finallyCost 赋值", "description": "终审通过取 estimatedCost；调整通过取 checkAdjustCost；拒绝取 standardCost。", "node": "申诉审核", "testType": "金额计算"},
    {"id": "R021", "name": "申诉跳过初审", "description": "新建申诉可直接进入 WAIT_LAST_CHECK 跳过初审。", "node": "申诉审核", "testType": "状态流转"},
    {"id": "R022", "name": "实勘不可上门补差", "description": "非可实勘房间若表价格>BOM价格，生成虚拟物品补差。", "node": "实勘审核", "testType": "规则校验"},
    {"id": "R023", "name": "灵之智能折扣", "description": "定制设计模式且灵之智能套组，按城市/全国规则与阈值匹配后折后价=原价×discountRate。", "node": "金额计算与汇总", "testType": "金额计算"},
    {"id": "R024", "name": "OfferRule 审核场景过滤", "description": "报价提交适用 ALL+仅设计师；造价审核适用 ALL+仅造价审核。", "node": "造价提交与审核", "testType": "规则校验"},
    {"id": "R025", "name": "失效释放库存", "description": "handleDesignCostExpire 置 INVALID 后调用 cancelLockStock 释放库存。", "node": "生命周期与外部联动", "testType": "状态流转"}
  ]
